 "script": "breathe-light-v2.m4a (practice) + breathe-light.m4a (intro, BOLT, closing)",
 "subtitles": [
  [
   13.0,
   15.86,
   "Welcome to the Breath Reset."
  ],
  [
   15.92,
   18.81,
   "Today we're going to practice Breathe Light,"
  ],
  [
   18.86,
   23.68,
   "learning to breathe a little quieter, softer, and more comfortably."
  ],
  [
   24.1,
   26.83,
   "We'll measure our BOLT score before and after,"
  ],
  [
   26.88,
   29.52,
   "just to notice whether anything changes."
  ],
  [
   29.72,
   31.0,
   "Let's begin."
  ],
  [
   31.98,
   35.84,
   "Take a few natural breaths through your nose."
  ],
  [
   37.62,
   40.03,
   "On my cue, you're going to be taking"
  ],
  [
   40.08,
   43.17,
   "one more inhale, and after the exhale,"
  ],
  [
   43.22,
   47.76,
   "I want you to pinch your nose, and the timer will start on the screen."
  ],
  [
   48.42,
   54.22,
   "Stop at the first clear urge to breathe, then return to normal breathing."
  ],
  [
   55.28,
   62.34,
   "Ready? Inhale. Exhale. And begin."
  ],
  [
   122.89,
   125.67,
   "Now make a note of your score,"
  ],
  [
   125.87,
   130.37,
   "and allow your breathing to return completely to normal."
  ],
  [
   132.68,
   137.71,
   "Gently close your eyes and allow your"
  ],
  [
   137.76,
   142.14,
   "sit bones to feel grounded beneath you."
  ],
  [
   142.76,
   149.46,
   "Imagine a piece of string lightly lifting you from the crown of your head."
  ],
  [
   150.68,
   154.29,
   "Let your shoulders soften and relax your jaw"
  ],
  [
   154.34,
   161.9,
   "and begin by simply noticing your breathing."
  ],
  [
   163.06,
   167.55,
   "Notice the air entering through the nose, perhaps feeling"
  ],
  [
   167.6,
   173.54,
   "slightly cooler as it comes in and a little warmer as it leaves."
  ],
  [
   174.42,
   179.36,
   "No need to change anything yet, just notice."
  ],
  [
   186.46,
   191.3,
   "Now begin to bring a little softness into your breathing."
  ],
  [
   191.5,
   197.99,
   "Allow the inhale to become gentle and quiet and"
  ],
  [
   198.04,
   202.8,
   "as you exhale simply allow the air to leave."
  ],
  [
   204.49,
   208.27,
   "No pushing, no forcing."
  ],
  [
   212.25,
   215.92,
   "With your next breath see if you can make the"
  ],
  [
   215.97,
   223.07,
   "inhale just a little smaller, a little softer."
  ],
  [
   224.2,
   227.89,
   "And allow the exhale to happen naturally."
  ],
  [
   230.28,
   232.15,
   "Imagine there's a delicate feather"
  ],
  [
   232.2,
   235.17,
   "resting just beneath your nose and as you"
  ],
  [
   235.22,
   239.59,
   "breathe in and out see if you can breathe"
  ],
  [
   239.64,
   244.9,
   "so gently that the feather barely moves."
  ],
  [
   245.16,
   248.85,
   "That's the quality we're looking for."
  ],
  [
   248.9,
   254.44,
   "Soft, quiet, imperceptible breathing."
  ],
  [
   264.94,
