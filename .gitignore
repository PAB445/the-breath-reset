# OS
.DS_Store
Thumbs.db

# Dev / test artifacts
output/
.playwright-cli/
tmp/master-*.wav
tmp/*.wav
tmp/test_*.mp4
tmp/frame_*.png
tmp/reel_test_*.mp4
tmp/story-frames/
tmp/event-ad-frames/
tmp/*.png

# Local tool caches / virtualenvs (never commit)
.venv/
tmp/.venv*/
tmp/.hf/
**/__pycache__/

# Social-only assets (not referenced by the website)
# Website uses: assets/social/instagram/practices/{coherent,extended-exhale}/reel-web.mp4 + poster-web.jpg
#              assets/social/youtube/founder-video/founder-story-v2-web.mp4 + cover-web.jpg
#              assets/photos/*, assets/events/*, assets/brand/logo.png + favicon.png

# Long-form YouTube exports (~5 min, 16:9) — upload to YouTube separately
assets/social/youtube/long/
assets/social/youtube/relax/long/

# YouTube Shorts — copies of the Instagram reels; regenerate via render_reel.py
assets/social/youtube/shorts/
assets/social/youtube/relax/shorts/

# Retrain YouTube working/final exports not embedded on the website
assets/social/youtube/retrain/breath-hold-test/*.mp4
!assets/social/youtube/retrain/breath-hold-test/Retrain_BreathHoldTest_Final.mp4

# Quiet breathing (Retrain) source + previews; regenerate the final via
# tmp/render_quiet_breathing.py
assets/social/youtube/retrain/quiet-breathing/*.mp4
tmp/quiet-breathing-frames/
tmp/quiet-frames/

# Founder source / working exports; keep only the site-ready web MP4 + cover
assets/social/youtube/founder-video/*.mov
assets/social/youtube/founder-video/founder-story-v2.mp4
assets/social/youtube/founder-video/founder-story-v2-final.mp4
assets/social/youtube/founder-video/end.png
assets/social/youtube/founder-video/overlays/
resources/founder-video-v2.mp4

# Instagram event creatives (ads / stories / posts — not embedded on the site)
assets/social/instagram/events/

# Practice working exports beyond the site reel + cover
assets/social/instagram/practices/*/end.png
assets/social/instagram/practices/*/reel_final.mp4
assets/social/instagram/practices/*/story_intro.mp4
assets/social/instagram/practices/*/breathing_sounds.m4a
assets/social/instagram/practices/*/story/

# Static PNG decks for manual CapCut / Instagram assembly
assets/social/instagram/reel-frames/
assets/social/instagram/carousels/
assets/social/instagram/posts/

# Event source clips; the site uses the silent *-web.mp4 + *-poster.jpg
assets/events/*/*.mp4
!assets/events/*/*-web.mp4
